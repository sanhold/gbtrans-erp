  societeId       String
  code            String   @db.VarChar(20)
  libelle         String   @db.VarChar(200)
  devise          String   @default("XOF") @db.VarChar(10)
  solde           Decimal  @default(0) @db.Decimal(18, 2)
  plafond         Decimal? @db.Decimal(18, 2)
  actif           Boolean  @default(true)
  compteComptable String?  @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  societe               Societe               @relation(fields: [societeId], references: [id])
  operations            OperationFinanciere[]
  depenses              Depense[]
  paiementsClients      Paiement[]
  paiementsFournisseurs PaiementFournisseur[]

  @@index([code])
  @@index([societeId])
  @@map("caisses")
}

model OperationFinanciere {
  id               String           @id @default(uuid())
  societeId        String
  numero           String           @db.VarChar(50)
  type             TypeOperationFin
  sens             SensOperation
  compteBancaireId String?
  caisseId         String?
  compteTiersId    String?
  agentId          String?
  dateOperation    DateTime         @default(now())
  montant          Decimal          @db.Decimal(18, 2)
  libelle          String           @db.VarChar(500)
  reference        String?          @db.VarChar(100)
  beneficiaire     String?          @db.VarChar(200)
  observations     String?          @db.Text
  statut           String           @default("VALIDE") @db.VarChar(20)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  societe        Societe         @relation(fields: [societeId], references: [id])
  compteBancaire CompteBancaire? @relation(fields: [compteBancaireId], references: [id])
  caisse         Caisse?         @relation(fields: [caisseId], references: [id])
  compteTiers    CompteTiers?    @relation(fields: [compteTiersId], references: [id])
  agent          Utilisateur?    @relation("OperationFinanciereAgent", fields: [agentId], references: [id])

  @@index([societeId])
  @@index([compteBancaireId])
  @@index([caisseId])
  @@index([compteTiersId])
  @@index([agentId])
  @@index([dateOperation])
  @@index([type])
  @@map("operations_financieres")
}

model CompteTiers {
  id              String   @id @default(uuid())
  societeId       String
  code            String   @db.VarChar(20)
  libelle         String   @db.VarChar(200)
  type            String   @db.VarChar(50)
  devise          String   @default("XOF") @db.VarChar(10)
  solde           Decimal  @default(0) @db.Decimal(18, 2)
  actif           Boolean  @default(true)
  compteComptable String?  @db.VarChar(20)
  observations    String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  societe               Societe               @relation(fields: [societeId], references: [id])
  operations            OperationFinanciere[]
  paiementsFournisseurs PaiementFournisseur[]

  @@unique([societeId, code])
  @@index([societeId])
  @@index([type])
  @@map("comptes_tiers")
}

model Rapprochement {
  id               String   @id @default(uuid())
  societeId        String
  compteBancaireId String
  dateBancaire     DateTime
  dateComptable    DateTime
  soldeReleve      Decimal  @db.Decimal(18, 2)
  soldeComptable   Decimal  @db.Decimal(18, 2)
  ecart            Decimal  @db.Decimal(18, 2)
  statut           String   @default("EN_COURS") @db.VarChar(20)
  observations     String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  societe        Societe        @relation(fields: [societeId], references: [id])
  compteBancaire CompteBancaire @relation(fields: [compteBancaireId], references: [id])

  @@index([societeId])
  @@index([compteBancaireId])
  @@map("rapprochements")
}

model Depense {
  id               String       @id @default(uuid())
  societeId        String
  numero           String       @db.VarChar(50)
  dossierId        String?
  fournisseurId    String?
  caisseId         String?
  compteBancaireId String?
  dotationId       String?
  dateDepense      DateTime     @default(now())
  categorie        String       @db.VarChar(100)
  designation      String       @db.VarChar(500)
  montant          Decimal      @db.Decimal(18, 2)
  modePaiement     ModePaiement
  reference        String?      @db.VarChar(100)
  observations     String?      @db.Text
  statut           String       @default("VALIDE") @db.VarChar(20)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  societe        Societe         @relation(fields: [societeId], references: [id])
  dossier        Dossier?        @relation(fields: [dossierId], references: [id])
  fournisseur    Fournisseur?    @relation(fields: [fournisseurId], references: [id])
  caisse         Caisse?         @relation(fields: [caisseId], references: [id])
  compteBancaire CompteBancaire? @relation(fields: [compteBancaireId], references: [id])
  dotation       Dotation?       @relation(fields: [dotationId], references: [id])

  @@index([societeId])
  @@index([dossierId])
  @@index([fournisseurId])
  @@index([caisseId])
  @@index([compteBancaireId])
  @@index([dotationId])
  @@index([dateDepense])
  @@index([categorie])
  @@map("depenses")
}

model Dotation {
  id           String   @id @default(uuid())
  societeId    String
  numero       String   @db.VarChar(50)
  dateDotation DateTime @default(now())
  montant      Decimal  @db.Decimal(18, 2)
  motif        String?  @db.Text
  agentId      String
  createurId   String
  statut       String   @default("VALIDE") @db.VarChar(20)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  societe  Societe     @relation(fields: [societeId], references: [id])
  agent    Utilisateur @relation("DotationAgent", fields: [agentId], references: [id])
  createur Utilisateur @relation("DotationCreateur", fields: [createurId], references: [id])
  depenses Depense[]

  @@unique([societeId, numero])
  @@index([societeId])
  @@index([agentId])
  @@map("dotations")
}

enum TypeOperationFin {
  ENCAISSEMENT
  DECAISSEMENT
  VIREMENT_INTERNE
  DOTATION
  RETRAIT
}

enum SensOperation {
  ENTREE
  SORTIE
}

// ============================================================================
// MODULE ADMISSIONS TEMPORAIRES
// ============================================================================

model AdmissionTemporaire {
  id                 String    @id @default(uuid())
  societeId          String
  numero             String    @db.VarChar(50)
  clientId           String?
  declarant          String?   @db.VarChar(200)
  nature             String?   @db.VarChar(200)
  dateCreation       DateTime  @default(now())
  dateDeclaration    DateTime?
  dateExpiration     DateTime
  dateRenouvellement DateTime?
  dureeInitiale      Int // en jours
  dureeProlongation  Int? // en jours
  delaiMois          Int?
  alerteJours        Int?      @default(90)

  // Garantie
  typeGarantie     String?  @db.VarChar(100)
  montantCaution   Decimal? @db.Decimal(18, 2)
  banqueCaution    String?  @db.VarChar(200)
  referenceCaution String?  @db.VarChar(100)

  // Marchandise
  designation String   @db.VarChar(500)
  valeur      Decimal? @db.Decimal(18, 2)
  quantite    Decimal? @db.Decimal(18, 3)

  // Régime
  regimeDouanier    String? @db.VarChar(100)
  bureauEntree      String? @db.VarChar(200)
  bureauSortie      String? @db.VarChar(200)
  declarationEntree String? @db.VarChar(100)

  // Apurement
  dateApurement      DateTime?
  montantApure       Decimal?  @db.Decimal(18, 2)
  referenceApurement String?   @db.VarChar(100)

  statut       StatutAT @default(ACTIVE)
  observations String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  societe       Societe                    @relation(fields: [societeId], references: [id])
  client        Client?                    @relation(fields: [clientId], references: [id])
  dossiers      Dossier[]
  documents     Document[]
  alertes       AlerteAT[]
  prolongations HistoriqueProlongationAT[]

  @@index([numero])
  @@index([statut])
  @@index([dateExpiration])
  @@index([societeId])
  @@map("admissions_temporaires")
}

model AlerteAT {
  id                    String    @id @default(uuid())
  admissionTemporaireId String
  type                  String    @db.VarChar(50) // EXPIRATION, RENOUVELLEMENT, APUREMENT
  dateAlerte            DateTime
  message               String    @db.VarChar(500)
  envoyee               Boolean   @default(false)
  dateEnvoi             DateTime?
  createdAt             DateTime  @default(now())

  admissionTemporaire AdmissionTemporaire @relation(fields: [admissionTemporaireId], references: [id], onDelete: Cascade)

  @@index([admissionTemporaireId])
  @@index([dateAlerte])
  @@map("alertes_at")
}

model HistoriqueProlongationAT {
  id                       String   @id @default(uuid())
  admissionTemporaireId    String
  dateProlongation         DateTime @default(now())
  ancienneDateExpiration   DateTime
  nouvelleDateExpiration   DateTime
  ancienNumeroDeclaration  String?  @db.VarChar(100)
  nouveauNumeroDeclaration String   @db.VarChar(100)
  dureeProlongationJours   Int
  utilisateur              String?  @db.VarChar(200)
  createdAt                DateTime @default(now())

  admissionTemporaire AdmissionTemporaire @relation(fields: [admissionTemporaireId], references: [id], onDelete: Cascade)

  @@index([admissionTemporaireId])
  @@map("historique_prolongations_at")
}

enum StatutAT {
  ACTIVE
  EXPIREE
  RENOUVELEE
  APUREE
  ANNULEE
  EN_CONTENTIEUX
}

// ============================================================================
// MODULE CAUTIONS
// ============================================================================

// Caution de dépôt conteneur versée aux compagnies maritimes (par dossier / N° BL),
// à ne pas confondre avec les garanties douanières rattachées aux AT (AdmissionTemporaire.montantCaution).
model Caution {
  id                String        @id @default(uuid())
  numero            Int           @unique @default(autoincrement())
  societeId         String
  dateCaution       DateTime?
  dossierId         String?
  numeroBL          String?       @db.VarChar(100)
  clientId          String?
  quantite          Int           @default(1)
  montant           Decimal       @db.Decimal(18, 2)
  compagnie         String?       @db.VarChar(100)
  dateDepotCourrier DateTime?
  datePaiement      DateTime?
  statut            StatutCaution @default(EN_ATTENTE)
  observations      String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  societe   Societe    @relation(fields: [societeId], references: [id])
  dossier   Dossier?   @relation(fields: [dossierId], references: [id])
  client    Client?    @relation(fields: [clientId], references: [id])
  documents Document[]

  @@index([societeId])
  @@index([statut])
  @@index([dossierId])
  @@index([clientId])
  @@map("cautions")
}

enum StatutCaution {
  NON_ACTIVE
  EN_ATTENTE
  COURRIER_DEPOSE
  PAYEE
}

// ============================================================================
// MODULE COURRIERS
// ============================================================================

model Courrier {
  id              String         @id @default(uuid())
  numero          String         @db.VarChar(50)
  type            TypeCourrier
  dateCreation    DateTime       @default(now())
  dateEnvoi       DateTime?
  dateReception   DateTime?
  objet           String         @db.VarChar(500)
  expediteur      String?        @db.VarChar(200)
  destinataire    String?        @db.VarChar(200)
  contenu         String?        @db.Text
  reference       String?        @db.VarChar(100)
  priorite        Priorite       @default(NORMALE)
  statut          StatutCourrier @default(BROUILLON)
  createurId      String
  classement      String?        @db.VarChar(100)
  accuseReception Boolean        @default(false)
  dateAccuse      DateTime?
  signature       String?
  cheminPDF       String?
  observations    String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  createur      Utilisateur           @relation("CourrierCreateur", fields: [createurId], references: [id])
  piecesJointes PieceJointeCourrier[]
  dossiers      CourrierDossier[]

  @@index([numero])
  @@index([type])
  @@index([statut])
  @@index([dateCreation])
  @@map("courriers")
}

model PieceJointeCourrier {
  id         String   @id @default(uuid())
  courrierId String
  nom        String   @db.VarChar(200)
  chemin     String   @db.VarChar(500)
  taille     Int
  typeMime   String   @db.VarChar(100)
  createdAt  DateTime @default(now())

  courrier Courrier @relation(fields: [courrierId], references: [id], onDelete: Cascade)

  @@index([courrierId])
  @@map("pieces_jointes_courriers")
}

model CourrierDossier {
  id         String @id @default(uuid())
  courrierId String
  dossierId  String

  courrier Courrier @relation(fields: [courrierId], references: [id])
  dossier  Dossier  @relation(fields: [dossierId], references: [id])

  @@unique([courrierId, dossierId])
  @@map("courriers_dossiers")
}

// Modèles réutilisables pour la rédaction rapide des courriers à envoyer (objet + corps avec variables).
model ModeleCourrier {
  id        String       @id @default(uuid())
  societeId String
  nom       String       @db.VarChar(200)
  type      TypeCourrier @default(SORTANT)
  objet     String       @db.VarChar(500)
  contenu   String       @db.Text
  actif     Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  societe Societe @relation(fields: [societeId], references: [id])

  @@index([societeId])
  @@index([type])
  @@map("modeles_courrier")
}

enum TypeCourrier {
  ENTRANT
  SORTANT
  INTERNE
}

enum Priorite {
  BASSE
  NORMALE
  HAUTE
  URGENTE
}

enum StatutCourrier {
  BROUILLON
  ENVOYE
  RECU
  TRAITE
  ARCHIVE
  ANNULE
}

// ============================================================================
// MODULE DOCUMENTS & ARCHIVES (GED)
// ============================================================================

model Document {
  id          String            @id @default(uuid())
  societeId   String
  nom         String            @db.VarChar(200)
  nomOriginal String            @db.VarChar(200)
  chemin      String            @db.VarChar(500)
  taille      Int
  typeMime    String            @db.VarChar(100)
  extension   String            @db.VarChar(20)
  categorie   CategorieDocument
  description String?           @db.VarChar(500)

  // Liens
  dossierId             String?
  clientId              String?
  fournisseurId         String?
  admissionTemporaireId String?
  cautionId             String?

  // OCR
  contenuOCR String? @db.Text
  ocrTraite  Boolean @default(false)

  // Versioning
  version       Int     @default(1)
  versionParent String?

  // Signature
  signe         Boolean   @default(false)
  signePar      String?   @db.VarChar(200)
  dateSignature DateTime?

  // QR Code
  qrCode String?

  archive   Boolean  @default(false)
  tags      String?  @db.VarChar(500)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe             Societe              @relation(fields: [societeId], references: [id])
  dossier             Dossier?             @relation(fields: [dossierId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  fournisseur         Fournisseur?         @relation(fields: [fournisseurId], references: [id])
  admissionTemporaire AdmissionTemporaire? @relation(fields: [admissionTemporaireId], references: [id])
  caution             Caution?             @relation(fields: [cautionId], references: [id])

  @@index([societeId])
  @@index([dossierId])
  @@index([clientId])
  @@index([categorie])
  @@index([createdAt])
  @@map("documents")
}

enum CategorieDocument {
  BL
  FACTURE_COMMERCIALE
  PACKING_LIST
  CERTIFICAT_ORIGINE
  CERTIFICAT_CONFORMITE
  DECLARATION_DOUANE
  BON_LIVRAISON
  CONNAISSEMENT
  LETTRE_VOITURE
  ASSURANCE
  LICENCE_IMPORT
  LICENCE_EXPORT
  AUTORISATION
  CONTRAT
  CERTIFICAT_PROLONGATION_AT
  CERTIFICAT_APUREMENT_AT
  CORRESPONDANCE
  PHOTO
  AUTRE
}

// ============================================================================
// MODULE NOTIFICATIONS
// ============================================================================

model Notification {
  id            String            @id @default(uuid())
  utilisateurId String
  type          TypeNotification
  titre         String            @db.VarChar(200)
  message       String            @db.Text
  lien          String?           @db.VarChar(500)
  module        String?           @db.VarChar(100)
  entiteId      String?           @db.VarChar(100)
  canal         CanalNotification @default(APP)
  lue           Boolean           @default(false)
  dateLecture   DateTime?
  envoyee       Boolean           @default(false)
  dateEnvoi     DateTime?
  createdAt     DateTime          @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([lue])
  @@index([createdAt])
  @@map("notifications")
}

enum TypeNotification {
  INFO
  ALERTE
  AVERTISSEMENT
  ERREUR
  SUCCES
  RAPPEL
  ECHEANCE
  PAIEMENT
  AT_EXPIRATION
  CAUTION_EXPIRATION
  DOSSIER_STATUT
  FACTURE
  COURRIER
}

enum CanalNotification {
  APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

// ============================================================================
// MODULE NUMÉROTATION
// ============================================================================

model Numerotation {
  id        String   @id @default(uuid())
  societeId String
  module    String   @db.VarChar(50) // DOSSIER, FACTURE, PROFORMA, COURRIER, etc.
  prefixe   String   @db.VarChar(20)
  suffixe   String?  @db.VarChar(20)
  compteur  Int      @default(0)
  longueur  Int      @default(6)
  annuel    Boolean  @default(true)
  annee     Int?
  format    String?  @db.VarChar(100) // ex: {PREFIX}/{ANNEE}/{COMPTEUR}
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe Societe @relation(fields: [societeId], references: [id])

  @@unique([societeId, module, annee])
  @@map("numerotations")
}

// ============================================================================
// MODULE PARAMÈTRES
// ============================================================================

model Parametre {
  id          String   @id @default(uuid())
  societeId   String?
  cle         String   @db.VarChar(100)
  valeur      String   @db.Text
  type        String   @default("STRING") @db.VarChar(20)
  module      String?  @db.VarChar(50)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  societe Societe? @relation(fields: [societeId], references: [id])

  @@unique([societeId, cle])
  @@map("parametres")
}

// ============================================================================
// MODULE MOBILE MONEY
// ============================================================================

model TransactionMobileMoney {
  id               String               @id @default(uuid())
  operateur        OperateurMobileMoney
  type             TypeTransactionMM
  montant          Decimal              @db.Decimal(18, 2)
  telephone        String               @db.VarChar(20)
  reference        String               @db.VarChar(100)
  referenceExterne String?              @db.VarChar(100)
  statut           StatutTransactionMM  @default(EN_ATTENTE)
  dateTransaction  DateTime             @default(now())
  dateConfirmation DateTime?
  factureId        String?
  clientId         String?
  observations     String?              @db.Text
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([reference])
  @@index([operateur])
  @@index([statut])
  @@index([dateTransaction])
  @@map("transactions_mobile_money")
