// ============================================================================
// MODULE PROFORMA
// ============================================================================

model Proforma {
  id           String         @id @default(uuid())
  numero       String         @db.VarChar(50)
  dossierId    String?
  clientId     String
  dateProforma DateTime       @default(now())
  dateValidite DateTime
  titre        String?        @db.VarChar(500)
  objet        String?        @db.VarChar(500)
  statut       StatutProforma @default(BROUILLON)

  // Valeurs douane
  fobUnitaire  Decimal? @db.Decimal(18, 2)
  fretUnitaire Decimal? @db.Decimal(18, 2)
  assurance    Decimal? @db.Decimal(18, 2)
  fraisDivers  Decimal? @db.Decimal(18, 2)
  nombreUnites Int      @default(1)
  valeurCAF    Decimal? @db.Decimal(18, 2)

  // Totaux
  montantHT    Decimal  @default(0) @db.Decimal(18, 2)
  montantTVA   Decimal  @default(0) @db.Decimal(18, 2)
  timbreFiscal Decimal  @default(0) @db.Decimal(18, 2)
  montantTTC   Decimal  @default(0) @db.Decimal(18, 2)
  remise       Decimal  @default(0) @db.Decimal(18, 2)
  conditions   String?  @db.Text
  observations String?  @db.Text
  factureId    String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  client  Client          @relation(fields: [clientId], references: [id])
  dossier Dossier?        @relation(fields: [dossierId], references: [id])
  facture Facture?        @relation(fields: [factureId], references: [id])
  lignes  LigneProforma[]

  @@index([clientId])
  @@index([dossierId])
  @@index([numero])
  @@index([statut])
  @@map("proformas")
}

model LigneProforma {
  id             String  @id @default(uuid())
  proformaId     String
  ordre          Int
  categorie      String? @db.VarChar(100)
  codePrestation String? @db.VarChar(50)
  designation    String  @db.VarChar(500)
  quantite       Decimal @default(1) @db.Decimal(18, 3)
  unite          String? @db.VarChar(50)
  prixUnitaire   Decimal @db.Decimal(18, 2)
  montantHT      Decimal @db.Decimal(18, 2)
  tauxTVA        Decimal @default(18) @db.Decimal(5, 2)
  montantTVA     Decimal @db.Decimal(18, 2)
  estTVA         Boolean @default(false)
  remise         Decimal @default(0) @db.Decimal(18, 2)

  proforma Proforma @relation(fields: [proformaId], references: [id], onDelete: Cascade)

  @@index([proformaId])
  @@map("lignes_proformas")
}

enum StatutProforma {
  BROUILLON
  VALIDEE
  EN_ATTENTE_FACTURATION
  ENVOYEE
  ACCEPTEE
  TRANSFORMEE
  EXPIREE
  ANNULEE
}

// ============================================================================
// MODULE FACTURATION
// ============================================================================

model Facture {
  id           String        @id @default(uuid())
  societeId    String
  numero       String        @db.VarChar(50)
  type         TypeFacture   @default(FACTURE)
  dossierId    String?
  clientId     String
  createurId   String
  dateFacture  DateTime      @default(now())
  dateEcheance DateTime
  objet        String?       @db.VarChar(500)
  statut       StatutFacture @default(BROUILLON)

  // Montants
  montantHT         Decimal  @default(0) @db.Decimal(18, 2)
  montantTVA        Decimal  @default(0) @db.Decimal(18, 2)
  timbreFiscal      Decimal  @default(0) @db.Decimal(18, 2)
  retenue           Decimal  @default(0) @db.Decimal(18, 2)
  montantTTC        Decimal  @default(0) @db.Decimal(18, 2)
  montantPaye       Decimal  @default(0) @db.Decimal(18, 2)
  resteAPayer       Decimal  @default(0) @db.Decimal(18, 2)
  acompte           Decimal  @default(0) @db.Decimal(18, 2)
  montantPrestation Decimal? @db.Decimal(18, 2)
  tvaPrestation     Decimal? @db.Decimal(18, 2)
  remise            Decimal  @default(0) @db.Decimal(18, 2)
  tauxTVA           Decimal  @default(18) @db.Decimal(5, 2)
  titre             String?  @db.VarChar(500)

  // Proforma source
  proformaSourceId String?

  // Devise
  devise     String  @default("XOF") @db.VarChar(10)
  tauxChange Decimal @default(1) @db.Decimal(18, 6)

  // Avoir lié
  factureOrigineId String?
  motifAvoir       String? @db.VarChar(500)

  // QR Code & Signature
  qrCode       String?
  signature    String?
  conditions   String? @db.Text
  observations String? @db.Text
  cheminPDF    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe        Societe             @relation(fields: [societeId], references: [id])
  client         Client              @relation(fields: [clientId], references: [id])
  dossier        Dossier?            @relation(fields: [dossierId], references: [id])
  createur       Utilisateur         @relation("FactureCreateur", fields: [createurId], references: [id])
  factureOrigine Facture?            @relation("FactureAvoir", fields: [factureOrigineId], references: [id])
  avoirs         Facture[]           @relation("FactureAvoir")
  proforma       Proforma?
  lignes         LigneFacture[]
  paiements      PaiementFacture[]
  ecritures      EcritureComptable[]

  @@unique([societeId, numero])
  @@index([societeId])
  @@index([clientId])
  @@index([dossierId])
  @@index([statut])
  @@index([dateFacture])
  @@index([dateEcheance])
  @@map("factures")
}

model LigneFacture {
  id              String  @id @default(uuid())
  factureId       String
  ordre           Int
  categorie       String? @db.VarChar(100)
  codePrestation  String? @db.VarChar(50)
  designation     String  @db.VarChar(500)
  estTVA          Boolean @default(false)
  quantite        Decimal @default(1) @db.Decimal(18, 3)
  unite           String? @db.VarChar(50)
  prixUnitaire    Decimal @db.Decimal(18, 2)
  montantHT       Decimal @db.Decimal(18, 2)
  tauxTVA         Decimal @default(18) @db.Decimal(5, 2)
  montantTVA      Decimal @db.Decimal(18, 2)
  remise          Decimal @default(0) @db.Decimal(18, 2)
  compteComptable String? @db.VarChar(20)

  facture Facture @relation(fields: [factureId], references: [id], onDelete: Cascade)

  @@index([factureId])
  @@map("lignes_factures")
}

model FactureFournisseur {
  id            String        @id @default(uuid())
  societeId     String
  numero        String        @db.VarChar(50)
  fournisseurId String
  dossierId     String?
  createurId    String
  dateFacture   DateTime      @default(now())
  dateEcheance  DateTime
  reference     String?       @db.VarChar(100)
  objet         String?       @db.VarChar(500)
  statut        StatutFacture @default(BROUILLON)
  montantHT     Decimal       @default(0) @db.Decimal(18, 2)
  montantTVA    Decimal       @default(0) @db.Decimal(18, 2)
  montantTTC    Decimal       @default(0) @db.Decimal(18, 2)
  montantPaye   Decimal       @default(0) @db.Decimal(18, 2)
  resteAPayer   Decimal       @default(0) @db.Decimal(18, 2)
  observations  String?       @db.Text
  cheminPDF     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  societe     Societe                      @relation(fields: [societeId], references: [id])
  fournisseur Fournisseur                  @relation(fields: [fournisseurId], references: [id])
  dossier     Dossier?                     @relation(fields: [dossierId], references: [id])
  createur    Utilisateur                  @relation("FactureFournisseurCreateur", fields: [createurId], references: [id])
  lignes      LigneFactureFournisseur[]
  paiements   PaiementFactureFournisseur[]

  @@unique([societeId, numero])
  @@index([societeId])
  @@index([fournisseurId])
  @@index([dossierId])
  @@index([statut])
  @@index([dateFacture])
  @@map("factures_fournisseurs")
}

model LigneFactureFournisseur {
  id                   String  @id @default(uuid())
  factureFournisseurId String
  ordre                Int
  designation          String  @db.VarChar(500)
  quantite             Decimal @default(1) @db.Decimal(18, 3)
  prixUnitaire         Decimal @db.Decimal(18, 2)
  montantHT            Decimal @db.Decimal(18, 2)
  tauxTVA              Decimal @default(18) @db.Decimal(5, 2)
  montantTVA           Decimal @db.Decimal(18, 2)

  factureFournisseur FactureFournisseur @relation(fields: [factureFournisseurId], references: [id], onDelete: Cascade)

  @@index([factureFournisseurId])
  @@map("lignes_factures_fournisseurs")
}

model PaiementFournisseur {
  id               String         @id @default(uuid())
  societeId        String
  numero           String         @db.VarChar(50)
  fournisseurId    String?
  datePaiement     DateTime       @default(now())
  montant          Decimal        @db.Decimal(18, 2)
  modePaiement     ModePaiement
  reference        String?        @db.VarChar(100)
  banque           String?        @db.VarChar(200)
  observations     String?        @db.Text
  statut           StatutPaiement @default(EN_ATTENTE)
  caisseId         String?
  compteBancaireId String?
  compteTiersId    String?
  createurId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  societe        Societe                      @relation(fields: [societeId], references: [id])
  fournisseur    Fournisseur?                 @relation(fields: [fournisseurId], references: [id])
  caisse         Caisse?                      @relation(fields: [caisseId], references: [id])
  compteBancaire CompteBancaire?              @relation(fields: [compteBancaireId], references: [id])
  compteTiers    CompteTiers?                 @relation(fields: [compteTiersId], references: [id])
  createur       Utilisateur?                 @relation("PaiementFournisseurCreateur", fields: [createurId], references: [id])
  affectations   PaiementFactureFournisseur[]

  @@index([societeId])
  @@index([fournisseurId])
  @@index([caisseId])
  @@index([compteBancaireId])
  @@index([compteTiersId])
  @@map("paiements_fournisseurs")
}

model PaiementFactureFournisseur {
  id                    String   @id @default(uuid())
  paiementFournisseurId String
  factureFournisseurId  String
  montant               Decimal  @db.Decimal(18, 2)
  createdAt             DateTime @default(now())

  paiementFournisseur PaiementFournisseur @relation(fields: [paiementFournisseurId], references: [id])
  factureFournisseur  FactureFournisseur  @relation(fields: [factureFournisseurId], references: [id])

  @@unique([paiementFournisseurId, factureFournisseurId])
  @@map("paiements_factures_fournisseurs")
}

enum TypeFacture {
  FACTURE
  AVOIR
  PROFORMA
  DUPLICATA
  DIVERSE
}

enum StatutFacture {
  BROUILLON
  VALIDEE
  ENVOYEE
  PARTIELLEMENT_PAYEE
  PAYEE
  EN_RETARD
  ANNULEE
  CONTENTIEUX
}

// ============================================================================
// MODULE PAIEMENTS
// ============================================================================

model Paiement {
  id               String         @id @default(uuid())
  numero           String         @db.VarChar(50)
  clientId         String?
  datePaiement     DateTime       @default(now())
  montant          Decimal        @db.Decimal(18, 2)
  modePaiement     ModePaiement
  reference        String?        @db.VarChar(100)
  banque           String?        @db.VarChar(200)
  observations     String?        @db.Text
  statut           StatutPaiement @default(EN_ATTENTE)
  caisseId         String?
  compteBancaireId String?
  createurId       String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  client         Client?             @relation(fields: [clientId], references: [id])
  caisse         Caisse?             @relation(fields: [caisseId], references: [id])
  compteBancaire CompteBancaire?     @relation(fields: [compteBancaireId], references: [id])
  createur       Utilisateur?        @relation("PaiementCreateur", fields: [createurId], references: [id])
  affectations   PaiementFacture[]
  ecritures      EcritureComptable[]

  @@index([clientId])
  @@index([datePaiement])
  @@index([statut])
  @@index([caisseId])
  @@index([compteBancaireId])
  @@map("paiements")
}

model PaiementFacture {
  id         String   @id @default(uuid())
  paiementId String
  factureId  String
  montant    Decimal  @db.Decimal(18, 2)
  createdAt  DateTime @default(now())

  paiement Paiement @relation(fields: [paiementId], references: [id])
  facture  Facture  @relation(fields: [factureId], references: [id])

  @@unique([paiementId, factureId])
  @@map("paiements_factures")
}

enum ModePaiement {
  ESPECES
  CHEQUE
  VIREMENT
  TRAITE
  MOBILE_MONEY
  ORANGE_MONEY
  MTN_MONEY
  WAVE
  MOOV_MONEY
  CARTE_BANCAIRE
  COMPENSATION
}

enum StatutPaiement {
  EN_ATTENTE
  VALIDE
  REJETE
  ANNULE
}

// ============================================================================
// MODULE COMPTABILITÉ OHADA / SYSCOHADA RÉVISÉ
// ============================================================================

model Exercice {
  id          String    @id @default(uuid())
  societeId   String
  code        String    @db.VarChar(20)
  libelle     String    @db.VarChar(200)
  dateDebut   DateTime
  dateFin     DateTime
  cloture     Boolean   @default(false)
  dateCloture DateTime?
  actif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  societe   Societe             @relation(fields: [societeId], references: [id])
  ecritures EcritureComptable[]

  @@unique([societeId, code])
  @@index([societeId])
  @@map("exercices")
}

model CompteComptable {
  id           String       @id @default(uuid())
  societeId    String
  numero       String       @db.VarChar(20)
  libelle      String       @db.VarChar(200)
  classe       Int // 1-9 OHADA
  type         TypeCompte
  nature       NatureCompte
  sens         SensCompte   @default(DEBITEUR)
  parent       String?      @db.VarChar(20)
  niveau       Int          @default(1)
  collectif    Boolean      @default(false)
  lettrable    Boolean      @default(false)
  rapprochable Boolean      @default(false)
  actif        Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  societe    Societe              @relation(fields: [societeId], references: [id])
  mouvements MouvementComptable[]

  @@unique([societeId, numero])
  @@index([societeId])
  @@index([classe])
  @@index([numero])
  @@map("comptes_comptables")
}

model JournalComptable {
  id                 String      @id @default(uuid())
  societeId          String
  code               String      @db.VarChar(10)
  libelle            String      @db.VarChar(200)
  type               TypeJournal
  compteContrepartie String?     @db.VarChar(20)
  actif              Boolean     @default(true)
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  societe   Societe             @relation(fields: [societeId], references: [id])
  ecritures EcritureComptable[]

  @@unique([societeId, code])
  @@index([societeId])
  @@map("journaux_comptables")
}

model EcritureComptable {
  id             String    @id @default(uuid())
  exerciceId     String
  journalId      String
  numero         String    @db.VarChar(50)
  dateEcriture   DateTime
  dateSaisie     DateTime  @default(now())
  libelle        String    @db.VarChar(500)
  reference      String?   @db.VarChar(100)
  piece          String?   @db.VarChar(100)
  factureId      String?
  paiementId     String?
  createurId     String
  validee        Boolean   @default(false)
  dateValidation DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  exercice   Exercice             @relation(fields: [exerciceId], references: [id])
  journal    JournalComptable     @relation(fields: [journalId], references: [id])
  facture    Facture?             @relation(fields: [factureId], references: [id])
  paiement   Paiement?            @relation(fields: [paiementId], references: [id])
  createur   Utilisateur          @relation("EcritureCreateur", fields: [createurId], references: [id])
  mouvements MouvementComptable[]

  @@index([exerciceId])
  @@index([journalId])
  @@index([dateEcriture])
  @@index([numero])
  @@map("ecritures_comptables")
}

model MouvementComptable {
  id                String    @id @default(uuid())
  ecritureId        String
  compteId          String
  libelle           String?   @db.VarChar(500)
  debit             Decimal   @default(0) @db.Decimal(18, 2)
  credit            Decimal   @default(0) @db.Decimal(18, 2)
  lettrage          String?   @db.VarChar(20)
  dateLettrage      DateTime?
  rapprochement     String?   @db.VarChar(50)
  dateRapprochement DateTime?

  ecriture EcritureComptable @relation(fields: [ecritureId], references: [id], onDelete: Cascade)
  compte   CompteComptable   @relation(fields: [compteId], references: [id])

  @@index([ecritureId])
  @@index([compteId])
  @@index([lettrage])
  @@map("mouvements_comptables")
}

enum TypeCompte {
  BILAN
  GESTION
  HORS_BILAN
}

enum NatureCompte {
  ACTIF
  PASSIF
  CHARGE
  PRODUIT
}

enum SensCompte {
  DEBITEUR
  CREDITEUR
}

enum TypeJournal {
  ACHAT
  VENTE
  BANQUE
  CAISSE
  OD
  SITUATION
  TRESORERIE
}

// ============================================================================
// MODULE FINANCE (CAISSE & BANQUE)
// ============================================================================

model CompteBancaire {
  id              String   @id @default(uuid())
  societeId       String
  code            String   @db.VarChar(20)
  libelle         String   @db.VarChar(200)
  banque          String   @db.VarChar(200)
  rib             String?  @db.VarChar(100)
  iban            String?  @db.VarChar(50)
  swift           String?  @db.VarChar(20)
  devise          String   @default("XOF") @db.VarChar(10)
  solde           Decimal  @default(0) @db.Decimal(18, 2)
  actif           Boolean  @default(true)
  compteComptable String?  @db.VarChar(20)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  societe               Societe               @relation(fields: [societeId], references: [id])
  operations            OperationFinanciere[]
  rapprochements        Rapprochement[]
  depenses              Depense[]
  paiementsClients      Paiement[]
  paiementsFournisseurs PaiementFournisseur[]

