generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================================
// MULTI-SOCIÉTÉS & MULTI-AGENCES
// ============================================================================

model Societe {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(20)
  raisonSociale  String   @db.VarChar(200)
  formeJuridique String?  @db.VarChar(50)
  capital        Decimal? @db.Decimal(18, 2)
  rccm           String?  @db.VarChar(50)
  ncc            String?  @db.VarChar(50)
  regime         String?  @db.VarChar(50)
  adresse        String?  @db.VarChar(500)
  ville          String?  @db.VarChar(100)
  pays           String   @default("Côte d'Ivoire") @db.VarChar(100)
  telephone      String?  @db.VarChar(50)
  mobile         String?  @db.VarChar(50)
  email          String?  @db.VarChar(200)
  siteWeb        String?  @db.VarChar(200)
  logo           String?
  devise         String   @default("XOF") @db.VarChar(10)
  tauxTVA        Decimal  @default(18) @db.Decimal(5, 2)
  timbreFiscal   Decimal  @default(0) @db.Decimal(18, 2)
  exerciceDebut  Int      @default(1)
  exerciceFin    Int      @default(12)
  smtpHost       String?  @db.VarChar(200)
  smtpPort       Int?
  smtpUser       String?  @db.VarChar(200)
  smtpPass       String?  @db.VarChar(200)
  smtpSecure     Boolean  @default(true)
  actif          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  agences               Agence[]
  utilisateurs          Utilisateur[]
  exercices             Exercice[]
  dossiers              Dossier[]
  clients               Client[]
  fournisseurs          Fournisseur[]
  factures              Facture[]
  comptes               CompteComptable[]
  journaux              JournalComptable[]
  numerotations         Numerotation[]
  parametres            Parametre[]
  comptesBancaires      CompteBancaire[]
  caisses               Caisse[]
  operationsFinancieres OperationFinanciere[]
  rapprochements        Rapprochement[]
  depenses              Depense[]
  comptesTiers          CompteTiers[]
  facturesFournisseur   FactureFournisseur[]
  paiementsFournisseurs PaiementFournisseur[]
  dotations             Dotation[]
  admissionsTemporaires AdmissionTemporaire[]
  documents             Document[]
  cautions              Caution[]
  modelesCourrier       ModeleCourrier[]

  @@map("societes")
}

model Agence {
  id          String   @id @default(uuid())
  societeId   String
  code        String   @db.VarChar(20)
  nom         String   @db.VarChar(200)
  adresse     String?  @db.VarChar(500)
  ville       String?  @db.VarChar(100)
  telephone   String?  @db.VarChar(50)
  email       String?  @db.VarChar(200)
  responsable String?  @db.VarChar(200)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  societe      Societe       @relation(fields: [societeId], references: [id])
  utilisateurs Utilisateur[]
  dossiers     Dossier[]

  @@unique([societeId, code])
  @@map("agences")
}

// ============================================================================
// AUTHENTIFICATION & SÉCURITÉ
// ============================================================================

model Utilisateur {
  id                 String    @id @default(uuid())
  societeId          String
  agenceId           String?
  matricule          String    @unique @db.VarChar(50)
  nom                String    @db.VarChar(100)
  prenom             String    @db.VarChar(100)
  email              String    @unique @db.VarChar(200)
  telephone          String?   @db.VarChar(50)
  motDePasse         String    @db.VarChar(255)
  avatar             String?
  doubleAuth         Boolean   @default(false)
  secretDoubleAuth   String?   @db.VarChar(255)
  actif              Boolean   @default(true)
  verrouille         Boolean   @default(false)
  tentativesEchouees Int       @default(0)
  derniereConnexion  DateTime?
  expirationMdp      DateTime?
  doitChangerMdp     Boolean   @default(false)
  tokenReset         String?   @db.VarChar(255)
  tokenResetExpire   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  societe                      Societe               @relation(fields: [societeId], references: [id])
  agence                       Agence?               @relation(fields: [agenceId], references: [id])
  profil                       Profil?               @relation(fields: [profilId], references: [id])
  profilId                     String?
  sessions                     Session[]
  journalAudit                 JournalAudit[]
  historiqueConnexions         HistoriqueConnexion[]
  dossiersCreateur             Dossier[]             @relation("DossierCreateur")
  dossiersAgent                Dossier[]             @relation("DossierAgent")
  facturesCreateur             Facture[]             @relation("FactureCreateur")
  facturesFournisseurCreateur  FactureFournisseur[]  @relation("FactureFournisseurCreateur")
  ecritures                    EcritureComptable[]   @relation("EcritureCreateur")
  courriersCreateur            Courrier[]            @relation("CourrierCreateur")
  notifications                Notification[]
  paiementsCreateur            Paiement[]            @relation("PaiementCreateur")
  paiementsFournisseurCreateur PaiementFournisseur[] @relation("PaiementFournisseurCreateur")
  operationsAgent              OperationFinanciere[] @relation("OperationFinanciereAgent")
  dotationsAgent               Dotation[]            @relation("DotationAgent")
  dotationsCreateur            Dotation[]            @relation("DotationCreateur")

  @@index([societeId])
  @@index([email])
  @@index([matricule])
  @@map("utilisateurs")
}

model Profil {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)
  nom         String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  estAdmin    Boolean  @default(false)
  actif       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  utilisateurs Utilisateur[]
  permissions  ProfilPermission[]

  @@map("profils")
}

model Permission {
  id        String   @id @default(uuid())
  module    String   @db.VarChar(100)
  action    String   @db.VarChar(100)
  libelle   String   @db.VarChar(200)
  createdAt DateTime @default(now())

  profils ProfilPermission[]

  @@unique([module, action])
  @@map("permissions")
}

model ProfilPermission {
  id           String @id @default(uuid())
  profilId     String
  permissionId String

  profil     Profil     @relation(fields: [profilId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([profilId, permissionId])
  @@map("profils_permissions")
}

model Session {
  id            String   @id @default(uuid())
  utilisateurId String
  token         String   @unique @db.VarChar(500)
  ipAdresse     String?  @db.VarChar(50)
  userAgent     String?  @db.VarChar(500)
  expiresAt     DateTime
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([utilisateurId])
  @@map("sessions")
}

model HistoriqueConnexion {
  id            String   @id @default(uuid())
  utilisateurId String
  ipAdresse     String?  @db.VarChar(50)
  userAgent     String?  @db.VarChar(500)
  statut        String   @db.VarChar(20) // SUCCESS, FAILED, LOCKED
  motif         String?  @db.VarChar(200)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([createdAt])
  @@map("historique_connexions")
}

model JournalAudit {
  id            String   @id @default(uuid())
  utilisateurId String?
  action        String   @db.VarChar(100)
  module        String   @db.VarChar(100)
  entite        String?  @db.VarChar(100)
  entiteId      String?  @db.VarChar(100)
  donneesAvant  Json?
  donneesApres  Json?
  ipAdresse     String?  @db.VarChar(50)
  userAgent     String?  @db.VarChar(500)
  createdAt     DateTime @default(now())

  utilisateur Utilisateur? @relation(fields: [utilisateurId], references: [id])

  @@index([utilisateurId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@index([entite, entiteId])
  @@map("journal_audit")
}

// ============================================================================
// MODULE DOSSIERS
// ============================================================================

model Dossier {
  id             String        @id @default(uuid())
  societeId      String
  agenceId       String?
  createurId     String
  agentId        String?
  numero         String        @db.VarChar(50)
  numeroPhysique String?       @db.VarChar(50)
  annee          Int
  nature         NatureDossier
  type           TypeDossier
  statut         StatutDossier @default(NOUVEAU)

  // Client
  clientId        String
  referenceClient String? @db.VarChar(100)

  // Transport Maritime
  compagnieMaritime String?   @db.VarChar(200)
  navire            String?   @db.VarChar(200)
  voyage            String?   @db.VarChar(100)
  numeroBL          String?   @db.VarChar(100)
  portOrigine       String?   @db.VarChar(200)
  portDestination   String?   @db.VarChar(200)
  dateArrivee       DateTime?
  dateDepart        DateTime?

  // Conteneur(s)
  conteneurs Conteneur[]

  // Marchandise
  designation String?  @db.Text
  poidsBrut   Decimal? @db.Decimal(18, 3)
  poidsNet    Decimal? @db.Decimal(18, 3)
  volume      Decimal? @db.Decimal(18, 3)
  nombreColis Int?
  emballage   String?  @db.VarChar(100)

  // Valeur et Douane
  valeurFOB  Decimal? @db.Decimal(18, 2)
  fret       Decimal? @db.Decimal(18, 2)
  assurance  Decimal? @db.Decimal(18, 2)
  valeurCAF  Decimal? @db.Decimal(18, 2)
  incoterm   String?  @db.VarChar(10)
  devise     String   @default("XOF") @db.VarChar(10)
  tauxChange Decimal  @default(1) @db.Decimal(18, 6)

  // Déclaration en Douane
  numeroDeclaration String?   @db.VarChar(100)
  dateDeclaration   DateTime?
  regimeDouanier    String?   @db.VarChar(100)
  bureauDouane      String?   @db.VarChar(200)
  positionTarifaire String?   @db.VarChar(50)
  droitDouane       Decimal?  @db.Decimal(18, 2)
  tva               Decimal?  @db.Decimal(18, 2)
  autresTaxes       Decimal?  @db.Decimal(18, 2)
  totalDroits       Decimal?  @db.Decimal(18, 2)

  // Livraison
  dateLivraison DateTime?
  lieuLivraison String?   @db.VarChar(500)
  bonLivraison  String?   @db.VarChar(100)

  // AT
  admissionTemporaireId String?

  // Processus de suivi
  processusId String?

  // Métadonnées
  observations     String?   @db.Text
  dateCreation     DateTime  @default(now())
  dateModification DateTime  @updatedAt
  dateCloture      DateTime?
  dateAnnulation   DateTime?
  motifAnnulation  String?   @db.VarChar(500)

  // Relations
  societe             Societe              @relation(fields: [societeId], references: [id])
  agence              Agence?              @relation(fields: [agenceId], references: [id])
  createur            Utilisateur          @relation("DossierCreateur", fields: [createurId], references: [id])
  agent               Utilisateur?         @relation("DossierAgent", fields: [agentId], references: [id])
  client              Client               @relation(fields: [clientId], references: [id])
  admissionTemporaire AdmissionTemporaire? @relation(fields: [admissionTemporaireId], references: [id])
  processus           ProcessusSuivi?      @relation(fields: [processusId], references: [id])

  articles            Article[]
  factures            Facture[]
  facturesFournisseur FactureFournisseur[]
  proformas           Proforma[]
  documents           Document[]
  historiqueDossier   HistoriqueDossier[]
  depenses            Depense[]
  courriers           CourrierDossier[]
  offres              OffreCommerciale[]
  cautions            Caution[]

  @@unique([societeId, numero, annee])
  @@unique([societeId, numeroPhysique])
  @@index([societeId])
  @@index([clientId])
  @@index([statut])
  @@index([nature])
  @@index([annee])
  @@index([dateCreation])
  @@index([numero])
  @@index([numeroBL])
  @@index([numeroDeclaration])
  @@map("dossiers")
}

model Conteneur {
  id        String   @id @default(uuid())
  dossierId String
  numero    String   @db.VarChar(50)
  type      String?  @db.VarChar(20) // 20', 40', 40'HC, etc.
  taille    String?  @db.VarChar(10)
  poids     Decimal? @db.Decimal(18, 3)
  scelle    String?  @db.VarChar(50)
  etat      String?  @db.VarChar(50)

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([numero])
  @@map("conteneurs")
}

// ============================================================================
// MODULE ARTICLES (marchandises du dossier)
// ============================================================================

model Article {
  id                String    @id @default(uuid())
  dossierId         String
  numero            Int
  designation       String    @db.VarChar(500)
  type              String?   @db.VarChar(100)
  marque            String?   @db.VarChar(200)
  modele            String?   @db.VarChar(200)
  quantite          Decimal   @default(1) @db.Decimal(18, 3)
  unite             String?   @db.VarChar(50)
  positionTarifaire String?   @db.VarChar(50)
  poids             Decimal?  @db.Decimal(18, 3)
  valeur            Decimal?  @db.Decimal(18, 2)
  origine           String?   @db.VarChar(100)
  dateLivraison     DateTime?
  bonLivraison      String?   @db.VarChar(100)
  observations      String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([positionTarifaire])
  @@map("articles")
}

// ============================================================================
// MODULE PROCESSUS DE SUIVI
// ============================================================================

model ProcessusSuivi {
  id          String         @id @default(uuid())
  societeId   String
  code        String         @db.VarChar(50)
  nom         String         @db.VarChar(200)
  description String?        @db.VarChar(500)
  nature      NatureDossier?
  actif       Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  etapes   EtapeProcessus[]
  dossiers Dossier[]

  @@unique([societeId, code])
  @@index([societeId])
  @@map("processus_suivi")
}

model EtapeProcessus {
  id          String   @id @default(uuid())
  processusId String
  ordre       Int
  code        String   @db.VarChar(50)
  nom         String   @db.VarChar(200)
  description String?  @db.VarChar(500)
  couleur     String?  @db.VarChar(20)
  delaiJours  Int?
  obligatoire Boolean  @default(true)
  createdAt   DateTime @default(now())

  processus ProcessusSuivi @relation(fields: [processusId], references: [id], onDelete: Cascade)

  @@index([processusId])
  @@map("etapes_processus")
}

model HistoriqueDossier {
  id          String         @id @default(uuid())
  dossierId   String
  action      String         @db.VarChar(100)
  statutAvant StatutDossier?
  statutApres StatutDossier?
  commentaire String?        @db.Text
  utilisateur String?        @db.VarChar(200)
  createdAt   DateTime       @default(now())

  dossier Dossier @relation(fields: [dossierId], references: [id], onDelete: Cascade)

  @@index([dossierId])
  @@index([createdAt])
  @@map("historique_dossiers")
}

enum NatureDossier {
  IMPORT
  EXPORT
  TRANSIT
  REEXPORT
  CABOTAGE
  TRANSBORDEMENT
}

enum TypeDossier {
  MARITIME
  AERIEN
  TERRESTRE
  MULTIMODAL
}

enum StatutDossier {
  NOUVEAU
  EN_COURS
  ATTENTE_CLIENT
  ATTENTE_DOUANE
  LIQUIDATION
  PAIEMENT
  MAIN_LEVEE
  LIVRAISON
  CLOTURE
  ANNULE
  ARCHIVE
}

// ============================================================================
// MODULE CLIENTS
// ============================================================================

model Client {
  id            String     @id @default(uuid())
  societeId     String
  code          String     @db.VarChar(20)
  type          TypeClient @default(ENTREPRISE)
  raisonSociale String     @db.VarChar(200)
  sigle         String?    @db.VarChar(50)
  ncc           String?    @db.VarChar(50)
  rccm          String?    @db.VarChar(50)
  regimeFiscal  String?    @db.VarChar(50)
  adresse       String?    @db.VarChar(500)
  ville         String?    @db.VarChar(100)
  pays          String     @default("Côte d'Ivoire") @db.VarChar(100)
  telephone     String?    @db.VarChar(50)
  mobile        String?    @db.VarChar(50)
  email         String?    @db.VarChar(200)
  siteWeb       String?    @db.VarChar(200)

  // Conditions commerciales
  conditionPaiement Int      @default(30) // jours
  plafondCredit     Decimal? @db.Decimal(18, 2)
  tauxRemise        Decimal  @default(0) @db.Decimal(5, 2)
  devise            String   @default("XOF") @db.VarChar(10)
  exonere           Boolean  @default(false)

  // État
  bloque       Boolean @default(false)
  motifBlocage String? @db.VarChar(500)
  actif        Boolean @default(true)
  archive      Boolean @default(false)
  solde        Decimal @default(0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe               Societe               @relation(fields: [societeId], references: [id])
  contacts              ContactClient[]
  dossiers              Dossier[]
  factures              Facture[]
  proformas             Proforma[]
  paiements             Paiement[]
  offres                OffreCommerciale[]
  documents             Document[]
  admissionsTemporaires AdmissionTemporaire[]
  cautions              Caution[]

  @@unique([societeId, code])
  @@index([societeId])
  @@index([raisonSociale])
  @@index([ncc])
  @@index([code])
  @@map("clients")
}

model ContactClient {
  id        String   @id @default(uuid())
  clientId  String
  nom       String   @db.VarChar(100)
  prenom    String?  @db.VarChar(100)
  fonction  String?  @db.VarChar(100)
  telephone String?  @db.VarChar(50)
  mobile    String?  @db.VarChar(50)
  email     String?  @db.VarChar(200)
  principal Boolean  @default(false)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("contacts_clients")
}

enum TypeClient {
  ENTREPRISE
  PARTICULIER
  ADMINISTRATION
  ONG
  DIPLOMATIQUE
}

// ============================================================================
// MODULE FOURNISSEURS
// ============================================================================

model Fournisseur {
  id            String          @id @default(uuid())
  societeId     String
  code          String          @db.VarChar(20)
  type          TypeFournisseur @default(PRESTATAIRE)
  raisonSociale String          @db.VarChar(200)
  sigle         String?         @db.VarChar(50)
  ncc           String?         @db.VarChar(50)
  rccm          String?         @db.VarChar(50)
  adresse       String?         @db.VarChar(500)
  ville         String?         @db.VarChar(100)
  pays          String          @default("Côte d'Ivoire") @db.VarChar(100)
  telephone     String?         @db.VarChar(50)
  mobile        String?         @db.VarChar(50)
  email         String?         @db.VarChar(200)
  siteWeb       String?         @db.VarChar(200)

  conditionPaiement Int     @default(30)
  devise            String  @default("XOF") @db.VarChar(10)
  rib               String? @db.VarChar(100)
  banque            String? @db.VarChar(200)

  actif     Boolean  @default(true)
  solde     Decimal  @default(0) @db.Decimal(18, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  societe             Societe               @relation(fields: [societeId], references: [id])
  contactsFournisseur ContactFournisseur[]
  facturesFournisseur FactureFournisseur[]
  paiements           PaiementFournisseur[]
  depenses            Depense[]
  documents           Document[]

  @@unique([societeId, code])
  @@index([societeId])
  @@index([raisonSociale])
  @@index([type])
  @@map("fournisseurs")
}

model ContactFournisseur {
  id            String   @id @default(uuid())
  fournisseurId String
  nom           String   @db.VarChar(100)
  prenom        String?  @db.VarChar(100)
  fonction      String?  @db.VarChar(100)
  telephone     String?  @db.VarChar(50)
  email         String?  @db.VarChar(200)
  principal     Boolean  @default(false)
  actif         Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fournisseur Fournisseur @relation(fields: [fournisseurId], references: [id], onDelete: Cascade)

  @@index([fournisseurId])
  @@map("contacts_fournisseurs")
}

enum TypeFournisseur {
  PRESTATAIRE
  TRANSPORTEUR
  COMPAGNIE_MARITIME
  COMPAGNIE_AERIENNE
  ACCONIER
  MAGASIN
  BANQUE
  DOUANE
  ASSURANCE
  TRANSITAIRE
  MANUTENTION
  AUTRE
}

// ============================================================================
// MODULE OFFRES COMMERCIALES
// ============================================================================

model OffreCommerciale {
  id           String      @id @default(uuid())
  numero       String      @db.VarChar(50)
  dossierId    String?
  clientId     String
  dateOffre    DateTime    @default(now())
  dateValidite DateTime
  objet        String      @db.VarChar(500)
  description  String?     @db.Text
  version      Int         @default(1)
  statut       StatutOffre @default(BROUILLON)
  montantHT    Decimal     @default(0) @db.Decimal(18, 2)
  montantTVA   Decimal     @default(0) @db.Decimal(18, 2)
  montantTTC   Decimal     @default(0) @db.Decimal(18, 2)
  remise       Decimal     @default(0) @db.Decimal(18, 2)
  conditions   String?     @db.Text
  observations String?     @db.Text
  proformaId   String?
  factureId    String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client  Client       @relation(fields: [clientId], references: [id])
  dossier Dossier?     @relation(fields: [dossierId], references: [id])
  lignes  LigneOffre[]

  @@index([clientId])
  @@index([numero])
  @@index([statut])
  @@map("offres_commerciales")
}

model LigneOffre {
  id           String  @id @default(uuid())
  offreId      String
  ordre        Int
  designation  String  @db.VarChar(500)
  quantite     Decimal @default(1) @db.Decimal(18, 3)
  unite        String? @db.VarChar(50)
  prixUnitaire Decimal @db.Decimal(18, 2)
  montantHT    Decimal @db.Decimal(18, 2)
  tauxTVA      Decimal @default(18) @db.Decimal(5, 2)
  montantTVA   Decimal @db.Decimal(18, 2)
  remise       Decimal @default(0) @db.Decimal(18, 2)

  offre OffreCommerciale @relation(fields: [offreId], references: [id], onDelete: Cascade)

  @@index([offreId])
  @@map("lignes_offres")
}

enum StatutOffre {
  BROUILLON
  ENVOYEE
  ACCEPTEE
  REFUSEE
  EXPIREE
  TRANSFORMEE
  ANNULEE
}

// ============================================================================
// MODULE PROSPECTS
// ============================================================================

model Prospect {
  id            String   @id @default(uuid())
  societeId     String
  raisonSociale String   @db.VarChar(200)
  contact       String?  @db.VarChar(200)
  telephone     String?  @db.VarChar(50)
  email         String?  @db.VarChar(200)
  activite      String?  @db.VarChar(200)
  source        String?  @db.VarChar(100)
  statut        String   @default("NOUVEAU") @db.VarChar(30)
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([societeId])
  @@index([statut])
  @@map("prospects")
}

