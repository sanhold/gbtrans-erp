{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "dub1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "prisma/data/**"
    },
    "api/migrer.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/sauvegardes",
      "schedule": "0 2 * * *"
    }
  ]
}
