# ============================================================================
# GBTRANS ERP - Configuration Environnement
# ============================================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://gbtrans:password@localhost:5432/gbtrans_erp?schema=public"

# Serveur
PORT=3001
NODE_ENV=development
API_PREFIX=/api/v1

# JWT
JWT_SECRET=votre-secret-jwt-ultra-securise-minimum-64-caracteres-generer-avec-openssl
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=votre-email@gmail.com
SMTP_PASS=votre-mot-de-passe-application

# SMS (Orange API CI)
ORANGE_API_URL=https://api.orange.com
ORANGE_API_KEY=votre-cle-api-orange
ORANGE_API_SECRET=votre-secret-orange
ORANGE_SENDER=GBTRANS

# Mobile Money
ORANGE_MONEY_MERCHANT_KEY=votre-cle-marchand
MTN_MONEY_API_KEY=votre-cle-mtn
WAVE_API_KEY=votre-cle-wave
MOOV_MONEY_API_KEY=votre-cle-moov

# Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Logs
LOG_LEVEL=info
LOG_DIR=./logs

# Sauvegarde
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# Chiffrement
ENCRYPTION_KEY=votre-cle-chiffrement-256-bits

# URL publique du frontend (liens des e-mails de réinitialisation) ; par défaut, la première valeur de CORS_ORIGIN
# FRONTEND_URL=https://votre-domaine.example

# E-mails de la plateforme (réinitialisation de mot de passe, notifications)
# PLATFORM_SMTP_HOST=smtp.example.com
# PLATFORM_SMTP_PORT=587
# PLATFORM_SMTP_SECURE=false
# PLATFORM_SMTP_USER=
# PLATFORM_SMTP_PASS=
# PLATFORM_SMTP_FROM="GBTrans <no-reply@example.com>"

# Paiement des abonnements PawaPay (repli : normalement saisi dans l'espace super-admin)
# PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
# PAWAPAY_API_TOKEN=

# Divers
# SLOW_QUERY_MS=300          # seuil de journalisation des requêtes lentes (défaut : 300 en production, 150 sinon)
# AUTH_RATE_LIMIT_MAX=20     # tentatives de connexion par fenêtre (relevé uniquement pour les tests)
